# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored — never commit real secrets.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# Hosted Postgres connection string.
#
# Neon:     https://console.neon.tech  → project → Connection string
#           postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/DB?sslmode=require
#
# Supabase: https://supabase.com/dashboard → project → Connect → Session pooler
#           postgresql://postgres.REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
#
# Use the DIRECT / session-pooler URL (port 5432), not the transaction pooler
# (6543) — drizzle-kit migrations need session-level features like prepared
# statements and advisory locks.
DATABASE_URL=

# --- GitHub (required for ingestion) ---------------------------------------
# Personal access token. A classic token with NO scopes, or a fine-grained
# token with "Public repositories (read-only)", is enough — we only read
# public data. Raises the limit from 60 to 5,000 REST requests/hour.
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=

# --- OpenAI (optional — enables LLM categorization) ------------------------
# Used only for repos the rule-based classifier can't confidently place.
# Leave blank to run rules-only; ingestion still works.
OPENAI_API_KEY=
# Cheap, fast model for classification.
OPENAI_MODEL=gpt-5-mini

# --- Ingestion tuning ------------------------------------------------------
# Minimum stars for a repo to enter the index during discovery.
MIN_STARS=50
# Max repos to process per discovery run (safety valve; 0 = unlimited).
DISCOVERY_LIMIT=2000
# Concurrent outbound requests to GitHub. Keep <= 8 to respect the
# documented secondary rate limit on concurrent requests.
GITHUB_CONCURRENCY=6
# Set to 1 to enable the LLM classification stage.
ENABLE_LLM_CLASSIFY=0

# --- Read caching ----------------------------------------------------------
# How long (seconds) the site reuses its whole-table aggregates: the homepage
# stat tiles, the category counts and the language/country filter dropdowns.
# Every page is force-dynamic, so without this each view re-scans the corpus —
# on a free-tier Postgres that is the difference between comfortable and over
# quota, especially once a crawler starts working through the sitemap. The
# underlying data only changes when `npm run daily` runs. Raise it if egress or
# Disk IO is tight; 0 disables caching (useful when debugging a stats query).
QUERY_CACHE_TTL_SECONDS=600

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_SITE_NAME=Top AI Repos
# Canonical site origin (no trailing slash). Set this to your PRODUCTION domain
# before building — it drives canonical tags, the sitemap, OG images and the
# proxy.ts redirect target. Any other owned domain listed in src/lib/domains.ts
# 308-redirects to whichever host this resolves to.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
